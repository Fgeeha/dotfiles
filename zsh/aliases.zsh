#
# Aliases.
#

# lsd — ls with icons for files/directories.
alias ls='lsd'
alias l='ls -l'
alias la='ls -a'
alias lla='ls -la'
alias lt='ls --tree'

# Wayland clipboard.
alias clip='wl-copy'

# Typo preserved verbatim from the original ~/.zshrc — this is the name that is
# actually in muscle memory. The correctly spelled alias below is additive.
alias lazydokcer='~/.local/bin/lazydocker'
alias lazydocker='~/.local/bin/lazydocker'
