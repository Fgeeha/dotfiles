# Settings for `nano` editor
# Full list of settings might be shown via `man nano`
# or here: https://www.nano-editor.org/dist/v3/nanorc.5.html

# Editor:
set tabstospaces
set trimblanks

set softwrap
set atblanks
set constantshow

# Extra files:
set backup
set backupdir "~/.nano-backups"
set historylog

# line numbers are copied with text,
# it is not useful:
# set linenumbers

## ── Syntax highlighting ──
# macOS (Homebrew, Apple Silicon)
include /opt/homebrew/opt/nano/share/nano/*.nanorc
include /opt/homebrew/opt/nano/share/nano/extra/*.nanorc

# macOS (Homebrew, Intel)
/usr/local/opt/nano/share/nano/*.nanorc
include /usr/local/opt/nano/share/nano/extra/*.nanorc

# Linux (дистрибутивные пакеты)
include /usr/share/nano/*.nanorc
include /usr/share/nano/extra/*.nanorc
